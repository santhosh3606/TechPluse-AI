# TechPulse AI - Environment Configuration Example
# Copy this file to .env and supply your API keys if desired.
# The application runs with 100% functionality out-of-the-box in Demo Mode without external keys.

# Google Gemini API key (Optional: for cloud LLM summarization)
GEMINI_API_KEY=

# ElevenLabs API key (Optional: for neural voice audio synthesis)
ELEVENLABS_API_KEY=

# Server Port and Host
PORT=8000
HOST=127.0.0.1
